<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RootNamespace>Markwardt.LiveAi</RootNamespace>
    <AssemblyName>Markwardt.LiveAi</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Markwardt.LiveAi</PackageId>
    <Authors>Chris Markwardt</Authors>
    <Description>Runs live AI coding sessions on the Claude Code and OpenAI Codex command line tools. A session is created from a provider (IPromptProvider.Claude or IPromptProvider.Codex, or a PromptProvider over another engine), an optional workspace folder and an optional API key, is identified by a GUID that the library stores and links to the tool's own session, and can be resumed from that GUID later.</Description>
    <PackageTags>ai;claude;claude-code;codex;openai;agent;session</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Markwardt-Labs/Live-Ai</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Markwardt-Labs/Live-Ai</PackageProjectUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
